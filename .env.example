# ── Fuente de datos ──────────────────────────────────────────────
# mock     → datos en memoria del navegador (localStorage) basados en el seed. No necesita Supabase.
# supabase → Postgres + Auth + Storage de Supabase (requiere las claves de abajo).
NEXT_PUBLIC_DATA_SOURCE=mock

# ── Supabase (completar cuando el proyecto exista) ───────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (server actions: invitar clientes, gestionar profes). NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Videos ───────────────────────────────────────────────────────
# Tamaño máximo por video en MB (50 = límite por archivo del plan gratis de Supabase).
NEXT_PUBLIC_MAX_VIDEO_MB=50
# Duración máxima sugerida en segundos.
NEXT_PUBLIC_MAX_VIDEO_SECONDS=60

# ── Otros ────────────────────────────────────────────────────────
# URL pública de la app (para los links de invitación y recuperación de contraseña).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp de Reactive para el botón del Perfil (formato internacional, sin + ni espacios).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Secreto para el hash de IP del límite anti-spam de «Pedir acceso» (opcional; si falta se usa la service role key).
ACCESS_IP_SALT=
